# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.DS_Store

# Not part of the reproducible pipeline:
#   archive/             exploratory analyses, superseded pipelines, raw run outputs
#   manuscript_figures/  local working copy of the manuscript (figure copies + LaTeX drafts)
#   figures/             first-version matplotlib figures (outdated; regenerated by 06_figures.py / 09_figures.py)
archive/
manuscript_figures/
figures/

# Written by clusterdopt/examples/quickstart.py
quickstart_model.npz

# Built tools and local configuration (written by install/install_chimes.sh)
external/
env.sh

# Large regenerable intermediates (design matrices, labels, gamma arrays, MD and DFT run directories)
retrospective/work/
md_audit/work/

# Result tables are rebuilt by the pipeline scripts and are not tracked. Exception: tables of expensive or
# non-bitwise-reproducible runs (~1,540 LAMMPS stability runs, MD early warning, VASP calibration).
retrospective/results/
md_audit/results/*
!md_audit/results/al_md_stability*.csv
!md_audit/results/al_md_seed_stats_*.csv
!md_audit/results/early_warning_*.csv
!md_audit/results/dft_calibration.csv
